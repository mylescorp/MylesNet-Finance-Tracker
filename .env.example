# Development only. `npm run dev` / Convex CLI should set this to your dev deployment.
# Do not copy the production URL here for local work.
NEXT_PUBLIC_CONVEX_URL=

# Optional install metadata. Subdomains below PWA_BASE_DOMAIN receive a
# host-specific app name and launch URL; unset values use the MylesNet brand.
PWA_BRAND_NAME=MylesNet Finance Tracker
PWA_SHORT_NAME=MylesNet Finance
PWA_DESCRIPTION=An auditable cashbook for your business.
PWA_THEME_COLOR=#1A395B
PWA_BACKGROUND_COLOR=#F3F3F1
PWA_BASE_DOMAIN=finance.mylescorptech.com

# The production target is documented in DEPLOYMENTS.md; configure it in Vercel.
# Convex Auth secrets and OWNER_SETUP_CODE belong in Convex environment variables.
